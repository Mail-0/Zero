# Use: node scripts/init-env.mjs. Never commit real values.
BRIDGE_SECRET=
BRIDGE_ENCRYPTION_KEY=
# Only list administrator-approved extra hosts. Known provider presets need no entries here.
BRIDGE_ALLOWED_MAIL_HOSTS=
# Exact origins, not full API paths. For example: https://llm.example.com,http://ollama:11434
BRIDGE_ALLOWED_AI_ORIGINS=
BRIDGE_PORT=3033
