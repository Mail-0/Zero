{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cedar-app",
  "compatibility_date": "2025-06-27",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./build/client/",
    "not_found_handling": "single-page-application",
    "html_handling": "force-trailing-slash",
  },
  "env": {
    "local": {
      "name": "cedar-app-local",
      "vars": {
        "VITE_PUBLIC_BACKEND_URL": "http://localhost:8787",
        "VITE_PUBLIC_APP_URL": "http://localhost:3000",
      },
    },
    "staging": {
      "name": "cedar-app-staging",
      "routes": [
        {
          "pattern": "mail-staging.cedarcopilot.com",
          "custom_domain": true,
        },
      ],
      "vars": {
        "VITE_PUBLIC_BACKEND_URL": "https://api.mail-staging.cedarcopilot.com",
        "VITE_PUBLIC_APP_URL": "https://mail-staging.cedarcopilot.com",
      },
    },
    "production": {
      "name": "cedar-app",
      "routes": [
        {
          "pattern": "mail.cedarcopilot.com",
          "custom_domain": true,
        },
      ],
      "vars": {
        "VITE_PUBLIC_BACKEND_URL": "https://api.mail.cedarcopilot.com",
        "VITE_PUBLIC_APP_URL": "https://mail.cedarcopilot.com",
      },
    },
  },
}
